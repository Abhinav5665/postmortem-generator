generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  
}

model Incident {
  id               String      @id @default(cuid())
  serviceName      String
  startTime        DateTime
  endTime          DateTime
  rawLogs          String      @db.Text
  engineerNotes    String      @db.Text
  severity         String
  status           String      @default("OPEN")

  templateType    String  @default("General")
  
  // Team members
  teamMembers       Json?

  createdAt        DateTime    @default(now())
  postmortem       Postmortem?
}

model Postmortem {
  id            String    @id @default(cuid())
  incidentId    String    @unique
  incident      Incident  @relation(fields: [incidentId], references: [id])
  
  // AI generated fields
  summary       String    @db.Text
  timeline      Json
  rootCause     String    @db.Text
  impact        String    @db.Text
  impactMetrics Json
  resolution    String    @db.Text
  wentWell      String    @db.Text
  severity      String

   recurringAlert Json?

   editHistory       Json?   // array of { field, oldValue, editedAt }

  // Action items with owner + due date
  actionItems   Json

  // Edit support
  isEdited      Boolean   @default(false)
  editedAt      DateTime?

  generatedAt   DateTime  @default(now())

  
}
model Settings {
  id           String   @id @default("default")
  slackWebhook String?
  updatedAt    DateTime @updatedAt


}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  role         String       @default("MEMBER")
  createdAt    DateTime     @default(now())
  invitations  Invitation[]
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  role        String    @default("MEMBER")
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id])
  createdAt   DateTime  @default(now())
}